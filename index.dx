### check-r1-theme-roles

::code
reads=/index.dx
runs=bash
---
#!/bin/bash
# Verify that a specific theme roles section exists in index.dx
if dx text index.dx --section r1-theme-roles-scope > /dev/null 2>&1; then
  echo "✓ PASS: Theme roles section found"
  exit 0
else
  echo "✗ FAIL: Section not found"
  exit 1
fi
::output
✓ PASS: Theme roles section found
