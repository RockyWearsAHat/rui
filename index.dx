## r1-widget-constants-extraction

::code
reads=src/widgets.rs,src/theme.rs
runs=bash
---
#!/bin/bash
echo "=== STEP 3: Widget Constants Extraction ==="
echo ""
echo "## Defined f32 Constants in widgets.rs"
grep -n "const.*f32 =" src/widgets.rs
echo ""
echo "## Metrics::DEFAULT values (theme.rs)"
grep -A 13 "pub const DEFAULT: Self = Self {" src/theme.rs | grep ": [0-9]"
echo ""
echo "## Hardcoded control_height (28.0) instances"
grep -n "\.h(28\.0)" src/widgets.rs | wc -l
echo "   Lines: $(grep -n '\.h(28\.0)' src/widgets.rs | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')"
echo ""
echo "## Hardcoded padding (12.0) instances"
grep -n "\.pad" src/widgets.rs | grep "12\.0" | wc -l
echo "   Lines: $(grep -n '\.pad.*12\.0' src/widgets.rs | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')"
echo ""
echo "## Hardcoded gap (8.0) instances"
grep -n "\.gap(8\.0)" src/widgets.rs | wc -l
echo "   Lines: $(grep -n '\.gap(8\.0)' src/widgets.rs | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')"
